        "default": "us"
    },
    {
        "id": "api_base_url",
        "label": "incipit-api URL, e.g. http://host:3737 - enables Hardcover, OpenLibrary and duration matching. Blank = Audible only.",
        "type": "text",
        "default": ""
    },
    {
        "id": "hardcover_token",
        "label": "Hardcover API token (free at hardcover.app/settings). Blank = skip Hardcover.",
        "type": "text",
        "option": "hidden",
        "default": ""
    },
    {
        "id": "keep_existing_genres",
        "label": "Keep existing genres",
        "type": "bool",
        "default": "false"
    },
    {
        "id": "store_author_as_mood",
        "label": "Add authors as Mood tags",
        "type": "bool",
        "default": "true"
    },
    {
        "id": "sort_author_by_last_name",
        "label": "Sort artists as [Last, First]",
        "type": "bool",
        "default": "true"
    },
    {
        "id": "strip_series_from_author",
        "label": "Strip a trailing series from author names: \"Author (Series)\" -> \"Author\"",
        "type": "bool",
        "default": "true"
    },
    {
        "id": "match_artist_from_folder",
        "label": "Recover the author from the folder path when the artist tag matches nothing (e.g. a narrator tagged as the artist)",
        "type": "bool",
        "default": "true"
    },
    {
        "id": "title_from_folder_when_missing",
        "label": "Recover the book title from the folder when the album tag is missing or \"[Unknown Album]\"",
        "type": "bool",
        "default": "true"
    },
    {
        "id": "simplify_title",
        "label": "Simplify titles (drop subtitle, series part, (un)abridged)",
        "type": "bool",
        "default": "false"
    },
    {
        "id": "prefer_local_cover",
        "label": "Keep local cover art selectable instead of replacing it with the matched cover. Does not make it the default poster.",
        "type": "bool",
        "default": "false"
    },
    {
        "id": "logging_level",
        "label": "Logging level:",
        "type": "enum",
        "values": ["DEBUG", "INFO", "WARN", "ERROR"],
        "default": "WARN"
    },
    {
        "id": "dev_disable_http_cache",
        "label": "Development: disable API response caching (slower; leave off for normal use)",
        "type": "bool",
        "default": "false"
    }
